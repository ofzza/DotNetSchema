<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Started by MSBuild as `dotnet exec <dll>`, never from a shell, so the native host is dead weight. -->
    <UseAppHost>false</UseAppHost>
    <!-- One process per consumer build; keep the fixed cost down. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetSchema.Generator\DotNetSchema.Generator.csproj" />
  </ItemGroup>

</Project>
