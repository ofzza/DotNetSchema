<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    A model library only needs the attribute. Outside this repository that is just:

      <PackageReference Include="DotNetSchema" Version="0.1.0-alpha.1" />

    from https://www.nuget.org/packages/DotNetSchema/

    It exports nothing itself: DotNetSchemaGenerate is not set here. The host that references this
    library opts in and picks these types up through its project-reference scan.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\DotNetSchema\DotNetSchema.csproj" />
  </ItemGroup>

  <Import Project="..\..\src\DotNetSchema\buildTransitive\DotNetSchema.targets" />

</Project>
