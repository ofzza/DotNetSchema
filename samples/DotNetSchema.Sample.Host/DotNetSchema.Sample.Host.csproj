<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    The host owns the documents. It opts in, and every build regenerates them from its own assembly and
    from every project it references (here, DotNetSchema.Sample.Models).
  -->
  <PropertyGroup>
    <DotNetSchemaGenerate>true</DotNetSchemaGenerate>
    <!-- Optional: write into the source tree instead of $(OutDir). Relative to this project. -->
    <DotNetSchemaOutputPath>schemas</DotNetSchemaOutputPath>
    <!--
      Optional: emit enums as enum plus x-enumNames instead of the default oneOf of titled constants, for
      code generators that only look for the vendor keyword.
    -->
    <DotNetSchemaEnumStyle>EnumWithNames</DotNetSchemaEnumStyle>
    <!--
      Optional: adjust which attributes are exposed under x-decorators (and mapped to standard keywords).
      Allow adds the models' own attributes to the default list; Deny takes defaults back out - here
      StringLength, so Customer.Name gets no maxLength. Both are ';'-separated lists of attribute full names,
      Ns.* wildcards or '*'; DotNetSchemaDecorators would replace the default list outright.
    -->
    <DotNetSchemaDecoratorsAllow>DotNetSchema.Sample.Models.*</DotNetSchemaDecoratorsAllow>
    <DotNetSchemaDecoratorsDeny>System.ObsoleteAttribute;System.ComponentModel.DataAnnotations.StringLengthAttribute</DotNetSchemaDecoratorsDeny>
  </PropertyGroup>

  <!--
    Optional: describe a type inline by a declared schema rather than as an object definition. CountryCode is
    written as a bare string by its own JsonConverter, which nothing in the export can see - this item is the
    promise that it writes what is declared here. A DotNetSchemaType item also beats a [DotNetSchemaType] on
    the type itself (as OrderNumber carries), so a host can correct a library's declaration.
  -->
  <ItemGroup>
    <DotNetSchemaType Include="DotNetSchema.Sample.Models.CountryCode" Type="string" Pattern="^[A-Z]{2}$" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetSchema.Sample.Models\DotNetSchema.Sample.Models.csproj" />
  </ItemGroup>

  <!--
    In-repository wiring only. Outside this repository the package reaches the host transitively through
    the models library (or by a PackageReference of its own), and this Import is not needed.
  -->
  <Import Project="..\..\src\DotNetSchema\buildTransitive\DotNetSchema.targets" />

</Project>
